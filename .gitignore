# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environment
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp
.DS_Store

# Secrets / local config
.env
.env.local

# Logs
*.log
# ...except raw game logs: they're the source data/games/ records are
# regenerated from (see data/games/README.md)
!data/games/**/*.log

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local sync debug dumps (generated by scripts/update_cards.py --dump)
data/egman_dump/

# Card art cache (downloaded on demand by render.py, regenerable)
data/cards/images/

# Local Claude Code permission overrides (machine-specific)
.claude/settings.local.json

# Stray Claude Code session/config data that ended up nested in this project
# directory (not project content — never commit this).
/~/
