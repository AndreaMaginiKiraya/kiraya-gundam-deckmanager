# Copy this file to ".env" and fill in real values.
# .env is gitignored; .env.example is committed as a template.

# Log level for the server and card-data sync (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: GitHub token for card-data sync (update_card_data / update_cards).
# Without it, GitHub's anonymous API limit is 60 requests/hour per IP; with
# it, 5000/hour. Any classic or fine-grained token works — no scopes needed
# (the apitcg repo is public).
#GITHUB_TOKEN=
